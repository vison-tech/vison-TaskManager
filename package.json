{
  "name": "taskmanager", "version": "0.1.0", "private": true, "type": "module",
  "engines": {"node": ">=24"},
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch apps/server/index.ts\" \"vite --config apps/web/vite.config.ts\"",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts",
    "start": "tsx apps/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "taskctl": "tsx apps/cli/index.ts",
    "mcp": "tsx apps/mcp/index.ts",
    "embed": "tsx apps/host/inject.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0", "hono": "^4.9.0", "zod": "^4.1.0",
    "react": "^19.2.0", "react-dom": "^19.2.0", "@tanstack/react-query": "^5.90.0",
    "@dnd-kit/core": "^6.3.1", "@dnd-kit/sortable": "^10.0.0", "@dnd-kit/utilities": "^3.2.2",
    "lucide-react": "^0.468.0", "react-markdown": "^10.1.0", "remark-gfm": "^4.0.1",
    "mermaid": "^11.0.0", "@modelcontextprotocol/sdk": "^1.20.0", "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0", "@types/react": "^19.2.0", "@types/react-dom": "^19.2.0", "@types/ws": "^8.18.0",
    "typescript": "^5.9.0", "tsx": "^4.20.0", "vite": "^7.1.0", "@vitejs/plugin-react": "^5.0.0", "concurrently": "^9.2.0", "@playwright/test": "^1.55.0"
  }
}
